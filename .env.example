# --- AI / sentiment classification ---
GOOGLE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SENTIMENT_MODEL=@cf/meta/llama-3.2-3b-instruct

# --- LLM7 (movement insight + market summary text) ---
LLM7_API_KEY=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=fast

# --- Market data / news ---
FINNHUB_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Unsplash (article thumbnail cache) ---
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=stocks-sentiment-analysis
UNSPLASH_DEFAULT_QUERY=stock market

# --- Mailgun (market summary email + /contact form) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_MARKET_LIST_ADDRESS=marketsummary@your-mailgun-domain
MAILGUN_FROM_EMAIL=Stock Sentiment App <postmaster@your-mailgun-domain>
# Inbox that receives /contact form submissions.
CONTACT_RECIPIENT_EMAIL=

# --- Cloudflare Turnstile (bot protection on /contact) ---
# Leave both unset to disable — the form and server both skip verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin: single bearer token protecting POST /api/market-summary/generate ---
ADMIN_API_TOKEN=

# --- Accounts: Supabase Auth (email/password + Google sign-in) ---
# NEXT_PUBLIC_* are exposed to the browser by design (anon key is safe to
# expose; it's constrained by Supabase's RLS/auth policies). The service
# role key must never be exposed client-side — used only for account
# deletion (supabase.auth.admin.deleteUser) in app/api/account/route.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IndexNow verification key (served back at /<key>.txt) ---
INDEXNOW_KEY=

# --- Site / infra ---
SITE_BASE_URL=http://localhost:3000
DATABASE_FILENAME=app.db

# --- Feature toggles ---
ENABLE_MARKET_SUMMARY=1
ENABLE_MAG7_SENTIMENT=1
FLASK_SKIP_SCHEDULER=

# --- Analytics (optional, e.g. self-hosted Umami) ---
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
