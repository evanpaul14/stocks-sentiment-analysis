[Unit]
Description=Stock Sentiment (Next.js)
After=network.target

[Service]
Type=simple
# Adjust these two paths for your server.
WorkingDirectory=/opt/stocks-sentiment-analysis-v2
# Calls `next start` directly rather than `npm run start` — skips the extra
# npm + shell wrapper process, which otherwise idles at ~50MB RSS for no benefit.
ExecStart=/opt/stocks-sentiment-analysis-v2/node_modules/.bin/next start
Restart=on-failure
RestartSec=5
User=stocksentiment
Group=stocksentiment
Environment=NODE_ENV=production
# The .env file in WorkingDirectory is loaded automatically by Next.js.
# Redirect stdout/stderr to the journal (default) — view with:
#   journalctl -u stocks-sentiment -f

[Install]
WantedBy=multi-user.target
