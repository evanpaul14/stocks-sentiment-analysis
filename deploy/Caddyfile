# Caddy automatically provisions HTTPS via Let's Encrypt and sets
# X-Forwarded-For, which lib/ratelimit relies on to key rate limits per IP.
# Replace the domain and adjust the upstream port if you changed it.

stocksentimentapp.com {
	reverse_proxy localhost:3000
}

